rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if user is admin
    function isAdmin() {
      return request.auth != null && 
             exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
    
    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Time Slots Configuration - Allow all authenticated users to read, only admins to write
    match /time_slots_config/{document=**} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }
    
    // Settings collection - Admin only
    match /settings/{document=**} {
      allow read, write: if isAdmin();
    }
    
    // Admin Settings - Admin only
    match /adminSettings/{document=**} {
      allow read, write: if isAdmin();
    }
    
    // App Settings - Allow all authenticated users to read, only admins to write
    match /app_settings/{document=**} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }
    
    // Users collection
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin() || request.auth.uid == userId;
    }
    
    // Admins collection - Admin only
    match /admins/{adminId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }
    
    // Bookings/Appointments
    match /bookings/{bookingId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update, delete: if isAdmin();
    }
    
    // Walk-ins - Admin only
    match /walkins/{walkinId} {
      allow read, write: if isAdmin();
    }
    
    // Archived bookings - Admin only
    match /archive_bookings/{archiveId} {
      allow read, write: if isAdmin();
    }
    
    // Services
    match /services/{serviceId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }
    
    // Technicians - Allow read for authenticated users, write for admins
    match /technicians/{technicianId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }
    
    // Promotions
    match /promotions/{promotionId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }
    
    // Reviews
    match /reviews/{reviewId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update, delete: if isAdmin();
    }
    
    // Damage Reports
    match /damage_reports/{reportId} {
      allow read: if isAdmin();
      allow create: if isAuthenticated();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }
    
    // Chat Rooms
    match /chat_rooms/{chatId} {
      allow read, write: if isAuthenticated();
      
      match /messages/{messageId} {
        allow read, write: if isAuthenticated();
      }
    }
    
    // Notifications
    match /notifications/{notificationId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }
    
    // Reschedule Requests
    match /reschedule_requests/{requestId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update, delete: if isAdmin();
    }
    
    // Default deny all other collections
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
